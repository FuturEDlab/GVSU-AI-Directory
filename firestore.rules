rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper for admin checks - Whitelisted Collaborators Included
    function isAdmin() {
      return request.auth != null && 
             (request.auth.token.email.lower() == "indrajis@mail.gvsu.edu" || 
              request.auth.token.email.lower() == "vanharkj@gvsu.edu" ||
              request.auth.token.email.lower() == "vanharkj@mail.gvsu.edu" ||
              request.auth.token.email.lower() == "joseph_email_here@gvsu.edu");
    }

    // 1. MASTER ADMIN OVERRIDE
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // 2. PUBLIC DIRECTORY ACCESS
    match /tools_published/{toolId} {
      allow read: if true; 
      
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      }

      match /user_votes/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 3. GLOBAL NEWS & CONFIG (Public Read)
    match /global_news/{articleId} {
      allow read: if true;
    }
    
    match /config/{configId} {
      allow read: if true;
    }

    // 4. SUBMISSIONS
    match /tools_submitted/{toolId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && 
                                    (resource.data.submitterId == request.auth.uid || isAdmin());
      
      match /tickets/{ticketId} {
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/tools_submitted/$(toolId)).data.submitterId == request.auth.uid;
        
        match /messages/{messageId} {
          allow read, write: if request.auth != null && get(/databases/$(database)/documents/tools_submitted/$(toolId)).data.submitterId == request.auth.uid;
        }
      }
    }

    // 5. USER PROFILES
    match /user_profiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 6. REPORTS
    match /reports/{reportId} {
      allow create: if request.auth != null && (request.resource.data.reporterUid == request.auth.uid || request.resource.data.reporterEmail == request.auth.token.email);
      allow read: if request.auth != null && (resource.data.reporterUid == request.auth.uid || resource.data.reporterEmail == request.auth.token.email);
    }

    // 7. COMMUNITY FEEDBACK
    match /feedbackPosts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAdmin() || (request.auth != null && (resource.data.authorUid == request.auth.uid || request.auth.uid in resource.data.contributors));
      allow delete: if isAdmin();
    }

    match /feedbackUpvotes/{voteId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // 8. CHANGELOGS
    match /releaseChangelogs/{releaseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. CHAT MODERATION REPORTS
    match /chatModerationReports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // 10. PROMPT LIBRARY
    match /promptLibrary/{promptId} {
      allow read: if resource.data.status == "APPROVED" || isAdmin() || (request.auth != null && resource.data.submittedBy == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.status == "PENDING" && request.resource.data.submittedBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
