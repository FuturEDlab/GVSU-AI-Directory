rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: admins/{userId}
    // Fields: email, role, createdAt
    //
    // Collection: tools_submitted/{toolId}
    // Fields: title, category, initialDescription, toolUrl, status, health,
    //         submitterDisplayName, submitterEmail, submitterId, isVerified, ...
    //
    // Collection: tools_published/{toolId}
    // Fields: title, category, pedagogicalNarrative, ogImageUrl, status, health,
    //         submitterDisplayName, submitterEmail, submitterId, upvotes, downvotes, ...
    //
    // Collection: tools_published/{toolId}/comments/{commentId}
    // Fields: toolId, userId, userDisplayName, content, createdAt
    //
    // Collection: tools_published/{toolId}/user_votes/{userId}
    // Fields: type, userId, createdAt
    //
    // Additional Collections:
    // - global_news/{articleId}, config/{configId}, releaseChangelogs/{releaseId}
    // - user_profiles/{userId}
    // - reports/{reportId}, tool_error_reports/{reportId}, chatModerationReports/{reportId}
    // - feedbackPosts/{postId}, feedbackUpvotes/{voteId}
    // - promptLibrary/{promptId}
    // - mail/{mailId}
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isGVSU() {
      return isAuthenticated() &&
        request.auth.token.email is string &&
        request.auth.token.email_verified == true &&
        (request.auth.token.email.lower().endsWith("@gvsu.edu") ||
         request.auth.token.email.lower().endsWith("@mail.gvsu.edu"));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
         (request.auth.token.email is string &&
          request.auth.token.email_verified == true &&
          request.auth.token.email.lower() in [
            "indrajis@mail.gvsu.edu",
            "vanharkj@mail.gvsu.edu",
            "indrajis@gvsu.edu",
            "vanharkj@gvsu.edu",
            "joseph_email_here@gvsu.edu"
          ]));
    }

    // ===============================================================
    // Domain Validation Functions
    // ===============================================================
    function isValidTool(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 100 &&
             data.category is string && data.category.size() > 0 && data.category.size() < 100 &&
             data.toolUrl is string && data.toolUrl.size() > 0 && data.toolUrl.size() < 2000 &&
             data.status in [
               "Submitted",
               "In Progress",
               "Review",
               "Pending",
               "Updated",
               "Completed",
               "Published",
               "Suspended",
               "Rejected"
             ];
    }

    function isValidComment(data) {
      return data.content is string &&
             data.content.size() > 0 &&
             data.content.size() < 1000 &&
             data.userId == request.auth.uid;
    }

    function isValidTicketMessage(data) {
      return data.senderId == request.auth.uid &&
             data.isAdmin is bool &&
             (data.isAdmin == false || isAdmin()) &&
             data.content is string &&
             data.content.size() > 0 &&
             data.content.size() < 2000;
    }

    function isValidVoteUpdate() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      let oldUp = resource.data.get('upvotes', 0);
      let oldDown = resource.data.get('downvotes', 0);
      return (
        (diff.hasOnly(['upvotes']) &&
         request.resource.data.upvotes is number &&
         (request.resource.data.upvotes == oldUp + 1 || request.resource.data.upvotes == oldUp - 1)) ||
        (diff.hasOnly(['downvotes']) &&
         request.resource.data.downvotes is number &&
         (request.resource.data.downvotes == oldDown + 1 || request.resource.data.downvotes == oldDown - 1)) ||
        (diff.hasOnly(['upvotes', 'downvotes']) &&
         request.resource.data.upvotes is number &&
         request.resource.data.downvotes is number &&
         ((request.resource.data.upvotes == oldUp + 1 && request.resource.data.downvotes == oldDown - 1) ||
          (request.resource.data.upvotes == oldUp - 1 && request.resource.data.downvotes == oldDown + 1)))
      );
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 1. ADMINS
    match /admins/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 2. PUBLIC DIRECTORY & NON-ADMIN FACULTY VOTING
    match /tools_published/{toolId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isGVSU() && isValidVoteUpdate());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isGVSU() && isValidComment(request.resource.data);
        allow update: if (isAdmin() || isOwner(resource.data.userId)) && isValidComment(request.resource.data);
        allow delete: if isAdmin() || isOwner(resource.data.userId);
      }

      match /user_votes/{userId} {
        allow read: if isAuthenticated();
        allow write: if isGVSU() && isOwner(userId);
      }
    }

    // 3. GLOBAL NEWS & CONFIG
    match /global_news/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. SUBMISSIONS & GOVERNANCE TICKETS
    match /tools_submitted/{toolId} {
      allow read: if isAdmin() || isOwner(resource.data.submitterId);
      allow create: if isGVSU() &&
        isValidTool(request.resource.data) &&
        request.resource.data.submitterId == request.auth.uid &&
        request.resource.data.status == "Submitted" &&
        request.resource.data.isVerified == false;
      allow update: if isAdmin() ||
        (isGVSU() &&
         isOwner(resource.data.submitterId) &&
         isValidTool(request.resource.data) &&
         request.resource.data.submitterId == resource.data.submitterId &&
         request.resource.data.status == resource.data.status &&
         request.resource.data.status != "Published" &&
         request.resource.data.isVerified == resource.data.isVerified &&
         request.resource.data.isVerified == false);
      allow delete: if isAdmin() || (isOwner(resource.data.submitterId) && resource.data.status != "Published");

      match /tickets/{ticketId} {
        allow read: if isAdmin() ||
          isOwner(resource.data.submitterId) ||
          isOwner(get(/databases/$(database)/documents/tools_submitted/$(toolId)).data.submitterId);
        allow create: if isAdmin() ||
          (isGVSU() && isOwner(get(/databases/$(database)/documents/tools_submitted/$(toolId)).data.submitterId));
        allow update, delete: if isAdmin();

        match /messages/{messageId} {
          allow read: if isAdmin() ||
            isOwner(get(/databases/$(database)/documents/tools_submitted/$(toolId)).data.submitterId);
          allow create: if isAuthenticated() &&
            (isAdmin() || isOwner(get(/databases/$(database)/documents/tools_submitted/$(toolId)).data.submitterId)) &&
            isValidTicketMessage(request.resource.data);
          allow update, delete: if isAdmin();
        }
      }
    }

    // 5. USER PROFILES
    match /user_profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isGVSU() && isOwner(userId));
    }

    // 6. REPORTS & TOOL ERROR REPORTS
    match /reports/{reportId} {
      allow create: if isGVSU() &&
        (request.resource.data.reporterUid == request.auth.uid ||
         (request.resource.data.reporterEmail is string &&
          request.resource.data.reporterEmail.lower() == request.auth.token.email.lower()));
      allow read: if isAdmin() ||
        (isGVSU() &&
         (resource.data.reporterUid == request.auth.uid ||
          (resource.data.reporterEmail is string &&
           resource.data.reporterEmail.lower() == request.auth.token.email.lower())));
      allow update, delete: if isAdmin();
    }

    match /tool_error_reports/{reportId} {
      allow create: if isGVSU();
      allow read, update, delete: if isAdmin();
    }

    // 7. COMMUNITY FEEDBACK
    match /feedbackPosts/{postId} {
      allow read: if true;
      allow create: if isGVSU() &&
        (request.resource.data.authorUid == request.auth.uid ||
         request.resource.data.authorId == request.auth.uid);
      allow update: if isAdmin() ||
        (isGVSU() && (
          resource.data.authorUid == request.auth.uid ||
          resource.data.authorId == request.auth.uid ||
          request.auth.uid in resource.data.contributors ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvoteCount']) &&
           request.resource.data.upvoteCount == resource.data.get('upvoteCount', 0) + 1) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contributors', 'updatedAt']) &&
           request.auth.uid in request.resource.data.contributors)
        ));
      allow delete: if isAdmin();
    }

    match /feedbackUpvotes/{voteId} {
      allow read: if true;
      allow create: if isGVSU() && request.resource.data.userId == request.auth.uid;
      allow delete: if isGVSU() && resource.data.userId == request.auth.uid;
    }

    // 8. CHANGELOGS
    match /releaseChangelogs/{releaseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. CHAT MODERATION REPORTS
    match /chatModerationReports/{reportId} {
      allow create: if isGVSU();
      allow read, update, delete: if isAdmin();
    }

    // 10. PROMPT LIBRARY
    match /promptLibrary/{promptId} {
      allow read: if resource.data.status == "APPROVED" ||
        isAdmin() ||
        (isAuthenticated() &&
         (resource.data.submittedBy == request.auth.uid ||
          resource.data.authorUid == request.auth.uid));
      allow create: if isGVSU() &&
        request.resource.data.status == "PENDING" &&
        (request.resource.data.submittedBy == request.auth.uid ||
         request.resource.data.authorUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // 11. MAIL QUEUE
    match /mail/{mailId} {
      allow create: if isGVSU() || isAdmin();
      allow read, update, delete: if isAdmin();
    }
  }
}
